---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const isExternal = href.startsWith('http');

const styles = {
  primary: 'bg-plum-500 text-white hover:bg-plum-700',
  secondary: 'bg-white text-plum-700 ring-1 ring-plum-300 hover:bg-plum-100',
};
---

<a
  href={href}
  rel={isExternal ? 'noopener' : undefined}
  target={isExternal ? '_blank' : undefined}
  class:list={[
    'inline-block rounded-full px-6 py-3 font-semibold transition-colors',
    styles[variant],
    className,
  ]}
>
  <slot />
</a>
