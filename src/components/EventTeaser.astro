---
import { formatLong } from '../utils/date';
import Button from './Button.astro';
import { site } from '../data/site';

interface Props {
  event?: {
    id: string;
    data: { title: string; date: Date; venue: string; summary?: string };
  };
}

const { event } = Astro.props;
---

<section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-plum-100 sm:p-8">
  {
    event ? (
      <>
        <p class="text-sm font-semibold tracking-wide text-plum-500 uppercase">Next meetup</p>
        <h2 class="font-display mt-2 text-3xl text-plum-700">{event.data.title}</h2>
        <p class="mt-2 text-lg">
          <time datetime={event.data.date.toISOString()}>{formatLong(event.data.date)}</time>
          <span aria-hidden="true"> · </span>
          {event.data.venue}
        </p>
        {event.data.summary && <p class="mt-3 max-w-prose">{event.data.summary}</p>}
        <div class="mt-6 flex flex-wrap gap-3">
          <Button href={`/events#${event.id}`} variant="secondary">
            Event details
          </Button>
          <Button href={site.facebookGroupUrl}>Join the group</Button>
        </div>
      </>
    ) : (
      <>
        <p class="text-sm font-semibold tracking-wide text-plum-500 uppercase">Next meetup</p>
        <h2 class="font-display mt-2 text-3xl text-plum-700">Being planned</h2>
        <p class="mt-2 max-w-prose text-lg">
          The next date is not fixed yet. Meetups are announced in the Facebook group first, so join
          there to hear about it as soon as it is set.
        </p>
        <div class="mt-6">
          <Button href={site.facebookGroupUrl}>Join the group</Button>
        </div>
      </>
    )
  }
</section>
